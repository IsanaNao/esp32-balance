# 复制成 .env.local 后填写（本地开发）；线上在 Vercel → Settings → Environment Variables 里填
# 生成随机值：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Atlas 专用用户 esp32-balance 的连接串，注意 .net/ 后面写 balance
MONGODB_URI=mongodb+srv://esp32-balance:<密码>@cluster4comments.xxxxx.mongodb.net/balance?retryWrites=true&w=majority

# 两人共用的 PWA 登录密码
APP_PASSWORD=

# 签发登录 Cookie 用，至少 32 个字符，用上面的命令生成
JWT_SECRET=

# 加密数据库里的 AI API Key，必须是 32 字节的 base64，用上面的命令生成
# 一旦设置不要再改，否则已保存的 Key 无法解密，需要重新填
ENCRYPTION_KEY=
